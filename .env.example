# Copy to .env.local and fill in. Nothing is required for `npm run lint|test|build`.
# Every var is documented in src/lib/env.ts.

# Neon Postgres (pooled connection string). Needed for db:migrate, db:seed and any page that reads data.
DATABASE_URL=

# OpenAI via the Vercel AI SDK. OPENAI_MODEL is the model id for every LLM call.
OPENAI_API_KEY=
OPENAI_MODEL=

# Firecrawl (Radar)
FIRECRAWL_API_KEY=

# Clerk. Leave both empty in local dev to use Clerk keyless mode (temporary keys in .clerk/).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The only Clerk user allowed in. Sign in once; /not-allowed shows your id to paste here.
OWNER_CLERK_USER_ID=

# Trigger.dev v4. Secret key: dashboard > API keys. Project ref: proj_... (used by trigger.config.ts).
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Vercel Blob (uploads and exported PNGs)
BLOB_READ_WRITE_TOKEN=

# tldraw (optional in development; Trial key for now, Hobby later)
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
